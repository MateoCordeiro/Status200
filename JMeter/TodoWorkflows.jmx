        <hashTree/>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="CreateTodo-Pacing pause" enabled="true">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">0</stringProp>
          <stringProp name="TestPlan.comments">Flow Control Action (pause) at the end of the workflow, as Eric showed on 2026-11-03. Its child timer does the actual waiting.</stringProp>
        </TestAction>
        <hashTree>
          <JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="Wait out the rest of the pacing time" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"/>
            <stringProp name="filename"/>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">long elapsed = System.currentTimeMillis() - Long.parseLong(vars.get(&quot;iterStart&quot;))
return Math.max(0L, Long.parseLong(vars.get(&quot;pacingMs&quot;)) - elapsed)</stringProp>
            <stringProp name="TestPlan.comments">Pacing = start of one iteration to start of the next. Waits pacingMs minus the time this iteration already took. If the iteration ran longer than pacingMs it waits 0, and the next iteration starts late (a saturation sign worth reporting).</stringProp>
          </JSR223Timer>
          <hashTree/>
        </hashTree>
      </hashTree>
